# App
NODE_ENV=development
PORT=3000
# Не используется как механизм авторизации. X-Session-ID — идентификатор сессии, не секрет доступа.
SESSION_SECRET=replace-with-a-long-random-secret

# PostgreSQL (local Docker)
DATABASE_URL=postgresql://navigator:navigator_dev_password@localhost:5433/navigator

# For container-to-container connections use:
# DATABASE_URL=postgresql://navigator:navigator_dev_password@db:5432/navigator

# Supabase / hosted Postgres example (fictitious values only):
# DATABASE_URL=postgresql://postgres.xxxx:replace-with-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# PGSSL=true
# PGSSL_REJECT_UNAUTHORIZED=true

# AI Gateway (OpenAI-compatible API for GigaChat)
AI_API_BASE_URL=https://litellmru.ds-hub-cf.ru/v1
AI_API_KEY=replace-with-ai-gateway-key
AI_MODEL=GigaChat-2-Pro
AI_TIMEOUT_MS=45000
